{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DCC CP/M: Debug active C file in Apple container",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Prepare active DCC file for full CP/M debugging",
      "program": "${fileDirname}/${fileBasenameNoExtension}.COM",
      "cwd": "${fileDirname}",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/scripts/z80-debug-proxy.py",
      "miDebuggerArgs": "--workspace \"${workspaceFolder}\" --program \"${fileDirname}/${fileBasenameNoExtension}.COM\"",
      "targetArchitecture": "x86",
      "stopAtEntry": false,
      "launchCompleteCommand": "exec-continue",
      "externalConsole": false
    },
    {
      "type": "espidf",
      "name": "ESP-IDF: Debug hardware (OpenOCD)",
      "request": "launch"
    },
    {
      "type": "gdbtarget",
      "request": "attach",
      "name": "Eclipse CDT GDB Adapter"
    }
  ]
}