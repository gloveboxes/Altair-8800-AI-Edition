100 SLEEP = 1
200 FOR I = 0 TO 999999
300 FOR J = 0 TO 999999
400 PRINT "Loop: ";I;" Counter: ";J
500 GOSUB 1000
600 NEXT J
700 NEXT I
800 END
1000 REM DEDICATED PORT 23, TIMER 3 IN SECONDS
1010 IF SLEEP < 0 OR SLEEP > 255 THEN PRINT "Invalid seconds":END
1020 OUT 23,19:OUT 23,SLEEP:OUT 23,35
1030 FOR T=1 TO 1000000
1040 S=INP(23)
1050 IF S=0 THEN RETURN
1060 IF S<>1 THEN GOTO 9700
1070 NEXT T
1080 PRINT "Timer did not expire":GOTO 9700
9700 V=INP(23):OUT 23,0:PRINT "Timer failed; interface reset":END
