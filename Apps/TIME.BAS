100 WIDTH 100
200 PRINT "==============================================="
300 PRINT "TIME DEMOS"
400 SECONDS=1
500 WHILE 1
600 PRINT "==============================================="
700 G=32:Q$=CHR$(0):E=-1:GOSUB 9000:PRINT "System tick count: ";R$
800 G=32:Q$=CHR$(1):E=-1:GOSUB 9000:PRINT "UTC date and time: ";R$
900 G=32:Q$=CHR$(2):E=-1:GOSUB 9000:PRINT "Local date and time: ";R$
1000 GOSUB 2000
1100 WEND
1200 END
2000 PRINT:PRINT "Pause";SECONDS;"seconds."
2010 IF SECONDS<0 OR SECONDS>255 THEN PRINT "Invalid seconds":END
2020 OUT 23,19:OUT 23,SECONDS:OUT 23,35
2030 FOR T=1 TO 1000000
2040 S=INP(23)
2050 IF S=0 THEN RETURN
2060 IF S<>1 THEN GOTO 9700
2070 NEXT T
2080 PRINT "Timer did not expire":GOTO 9700
9000 REM GROUP G, RAW PAYLOAD Q$, E=EXPECTED BYTES (-1 FOR TEXT)
9010 IF INP(2)<>0 THEN GOTO 9800
9020 OUT 2,G:OUT 3,LEN(Q$) MOD 256:OUT 3,INT(LEN(Q$)/256)
9030 FOR X=1 TO LEN(Q$):OUT 3,ASC(MID$(Q$,X,1)):NEXT X
9040 FOR P=1 TO 30000
9050 S=INP(2)
9060 IF S=1 OR S=2 OR S=255 THEN GOTO 9100
9070 IF S<>3 AND S<>4 THEN GOTO 9800
9080 NEXT P
9090 PRINT "Service timeout":GOTO 9800
9100 R$="":RL=0
9110 IF S=1 THEN OUT 2,0:IF E=0 THEN RETURN ELSE GOTO 9800
9120 RL=INP(4):RL=RL+256*INP(4)
9130 IF RL>2048 THEN GOTO 9800
9140 FOR X=1 TO RL
9150 V=INP(4)
9160 IF S<>255 AND RL<=255 THEN R$=R$+CHR$(V)
9170 NEXT X
9180 IF S=255 THEN PRINT "Service error":GOTO 9800
9190 IF E=0 OR RL>255 THEN GOTO 9800
9200 IF E>=0 AND RL<>E THEN GOTO 9800
9210 IF INP(2)<>0 THEN GOTO 9800
9220 RETURN
9700 V=INP(23):OUT 23,0:PRINT "Timer failed; interface reset":END
9800 OUT 2,1:PRINT "Service failed; transport reset":END
